#import "kss_parser"

// Laws for the byte classes the KSS lexer reads. Each states the expected
// behavior independently of the implementation; `ziran check --project`
// proves it for every byte. An implementation edit may not change this
// file.

Digit :: (b: s32) -> bool { return b >= 48 && b <= 57 }
Letter :: (b: s32) -> bool { return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) }

// White space is the space and the ASCII controls from tab to carriage
// return; nothing else, NUL included.
#law SpaceRule forall b: 0..255 => KssIsSpace(cast(u8)b) == (b == 32 || (b >= 9 && b <= 13));

// Digits are 0 to 9, letters are A to Z in either case, and hex digits are
// digits and the letters A to F in either case.
#law DigitRule forall b: 0..255 => KssIsDigit(cast(u8)b) == Digit(b);
#law AlphaRule forall b: 0..255 => KssIsAlpha(cast(u8)b) == Letter(b);
#law HexRule forall b: 0..255 => KssIsHexDigit(cast(u8)b) == (Digit(b) || (b >= 65 && b <= 70) || (b >= 97 && b <= 102));

// Names start with a letter, underscore, or hyphen, never a digit or dot,
// and every byte that starts a name may continue one.
#law NameStartRule forall b: 0..255 => KssIdentStart(cast(u8)b) == (Letter(b) || b == 95 || b == 45);
#law StartContinues forall b: 0..255 => !KssIdentStart(cast(u8)b) || KssIdentChar(cast(u8)b);

// Names continue with digits and dots too; selector names take every byte a
// name does except the dot, which separates classes.
#law NameCharRule forall b: 0..255 => KssIdentChar(cast(u8)b) == (Letter(b) || Digit(b) || b == 95 || b == 45 || b == 46);
#law SelectorDropsDot forall b: 0..255 => KssSelectorIdentChar(cast(u8)b) == (KssIdentChar(cast(u8)b) && b != 46);
