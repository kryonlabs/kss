#import "css_export"
#import "std/text"
#import "kss_parser"
output: [8192]u8;

#program_export
Answer :: () -> s32 {
    source: string = "@pack demo; tokens { color { ink: #112233; } length { pad: 8; } } Button.hero { foreground: ink; padding-x: pad; opacity: 0.5; line-height: 20px; } @media (max-width: 600px) { main > Text { font-size: 18; } }"
    exported: CSSExport = ExportCSS(source, "test.kss", KssDefaultEnvironment(), output[:])
    if !exported.ok { print("%\n", exported.error); return 1 }
    {
    text: string = TextView(output[:exported.count])
    if !ContainsFoldASCII(text, "[data-kryon-widget=\"Button\"][data-kryon-class=") ||
        !ContainsFoldASCII(text, "color: #112233ff;") || !ContainsFoldASCII(text, "padding-left: 8px;") ||
        !ContainsFoldASCII(text, "padding-right: 8px;") || !ContainsFoldASCII(text, "opacity: 0.5;") ||
        !ContainsFoldASCII(text, "@media (max-width: 600px)") || !ContainsFoldASCII(text, "font-size: 18px;") ||
        !ContainsFoldASCII(text, "line-height: 20px;") { return 2 }
    }
    tiny: [2]u8
    if ExportCSS("Button { radius: 8; }", "small.kss", KssDefaultEnvironment(), tiny[:]).ok { return 3 }
    if ExportCSS("@import <base>;", "import.kss", KssDefaultEnvironment(), output[:]).ok { return 4 }
    if ExportCSS("Button { material: glass; }", "material.kss", KssDefaultEnvironment(), output[:]).ok { return 5 }
    if ExportCSS("Button:is(.hero) { radius: 8; }", "selector.kss", KssDefaultEnvironment(), output[:]).ok { return 6 }
    return 42
}
