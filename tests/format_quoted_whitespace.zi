#import "kss_formatter"

// Vertical tab and form feed between tokens are whitespace the formatter
// may drop, but inside quoted text they are content and must survive.
Covered :: (result: KssFormatResult, at: s32) -> bool {
    index: s32 = 0
    while index < result.count {
        segment: KssFormatSegment = result.segments[index]
        if segment.kind == 0 && segment.start <= at &&
            at < segment.start + segment.length { return true }
        index += 1
    }
    return false
}

#program_export
main :: () -> s32 {
    source: string = "Text {\f typeface: \"a\fb\x0bc\"; }\n"
    result: KssFormatResult = KssFormat(source)
    if !result.ok { return 1 }
    // Bytes 20 and 22 are the form feed and vertical tab inside the quotes.
    if source[20] != 12 || source[22] != 11 { return 2 }
    if !Covered(result, 20) || !Covered(result, 22) { return 3 }
    return 0
}
